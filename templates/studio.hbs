<div class="waterline-studio-root">

    <!-- Primary Navigation Tabs -->
    <nav class="waterline-tabs" aria-label="Waterline Tabs">
        <button type="button" class="waterline-tab-btn {{#if (eq activeTab 'water')}}active{{/if}}" data-tab="water">
            <i class="fas fa-water"></i> <span>Water Zones & FX</span>
        </button>
        <button type="button" class="waterline-tab-btn {{#if (eq activeTab 'wake')}}active{{/if}}" data-tab="wake">
            <i class="fas fa-wave-square"></i> <span>Wake & Ripples</span>
        </button>
    </nav>

    <div class="waterline-tab-body">

        <!-- ========================================================= -->
        <!-- TAB 1: WATER ZONES & FX                                   -->
        <!-- ========================================================= -->
        <section class="tab {{#if (eq activeTab 'water')}}active{{/if}}" data-tab="water">

            <!-- 1. Scene Waterbodies Entity Deck -->
            <div class="wc-entity-deck">
                <div class="wc-deck-header">
                    <div class="wc-deck-title">
                        <i class="fas fa-layer-group"></i>
                        <span>Scene Waterbodies</span>
                        <span class="wc-zone-count-badge">{{zones.length}}</span>
                    </div>
                    <button type="button" class="cartograph-btn-mini {{#if pickActive}}pick-active{{/if}}" data-action="togglePick" title="{{#if pickActive}}Stop sampling{{else}}Sample water from map (Shift to add, Ctrl to subtract){{/if}}">
                        {{#if pickActive}}
                        <i class="fas fa-stop-circle"></i> Stop
                        {{else}}
                        <i class="fas fa-crosshairs"></i> New Waterbody
                        {{/if}}
                    </button>
                </div>

                <!-- Pick Mode Controls -->
                {{#if pickActive}}
                <div class="wc-pick-controls ionrift-subcard">
                    <div class="form-group-compact">
                        <label title="How far from clicked color the fill spreads">Tolerance</label>
                        <input type="range" name="pickTolerance" min="1" max="120" value="{{pickTolerance}}" step="1" />
                        <span class="range-val">{{pickTolerance}}</span>
                    </div>
                    <div class="form-group-compact">
                        <label title="Edge smoothing: lower = detailed, higher = cleaner">Smoothing</label>
                        <input type="range" name="pickSmoothing" min="0.5" max="15" value="{{pickSmoothing}}" step="0.5" />
                        <span class="range-val">{{pickSmoothing}}</span>
                    </div>
                    <div class="wc-refine-hint">
                        <i class="fas fa-mouse-pointer"></i> Click map to sample. <kbd>Shift</kbd>+Click to add, <kbd>Ctrl</kbd>+Click to subtract.
                    </div>
                </div>
                {{/if}}

                <!-- Live Candidate Card -->
                {{#if candidate}}
                <div class="wc-candidate ionrift-subcard {{#if editingRegionName}}editing{{/if}}">
                    <div class="wc-candidate-header">
                        <i class="fas {{#if editingRegionName}}fa-pen-nib{{else}}fa-magic{{/if}}"></i>
                        {{#if editingRegionName}}
                        <span>Refining: <strong>{{editingRegionName}}</strong> ({{candidate.vertexCount}} pts)</span>
                        {{else}}
                        <span>Sampled: {{candidate.vertexCount}} pts</span>
                        {{/if}}
                        {{#if candidate.estimation}}
                        <span class="wc-candidate-tag" title="{{candidate.estimation.explanation}}">
                            <i class="{{candidate.estimation.icon}}" style="color: {{candidate.estimation.accentColor}};"></i>
                            {{candidate.estimation.archetypeLabel}}
                            {{#if candidate.estimation.hasDirection}}
                            &bull; {{candidate.estimation.flowAngle}}°
                            {{/if}}
                        </span>
                        {{/if}}
                    </div>
                    {{#if (gt candidate.vertexCount 60)}}
                    <p class="wc-vert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        Complex boundary ({{candidate.vertexCount}} pts). Increase Smoothing to optimize.
                    </p>
                    {{/if}}
                    <div class="wc-candidate-toolbar">
                        <span class="wc-toolbar-label"><i class="fas fa-sliders-h"></i> Boundary:</span>
                        <div class="wc-toolbar-buttons">
                            <button type="button" class="cartograph-btn wc-btn-tool" data-action="pullBackCandidate" title="Pull boundary back / shrink inward (Erode 1 step)">
                                <i class="fas fa-compress-alt"></i> Pull Back
                            </button>
                            <button type="button" class="cartograph-btn wc-btn-tool" data-action="expandCandidate" title="Expand boundary outward (Dilate 1 step)">
                                <i class="fas fa-expand-alt"></i> Expand
                            </button>
                            <button type="button" class="cartograph-btn wc-btn-tool" data-action="smoothCandidate" title="Smooth jagged corners and stair-steps">
                                <i class="fas fa-bezier-curve"></i> Smooth
                            </button>
                        </div>
                    </div>
                    <div class="wc-refine-hint">
                        <i class="fas fa-layer-group"></i> <kbd>Shift</kbd>+Click map to add regions, <kbd>Ctrl</kbd>+Click to subtract.
                    </div>
                    <div class="wc-candidate-actions">
                        <button type="button" class="cartograph-btn cartograph-btn-accept" data-action="acceptCandidate">
                            <i class="fas fa-check"></i> {{#if editingRegionName}}Update Waterbody{{else}}Accept{{/if}}
                        </button>
                        <button type="button" class="cartograph-btn cartograph-btn-discard" data-action="discardCandidate">
                            <i class="fas fa-times"></i> {{#if editingRegionName}}Cancel{{else}}Discard{{/if}}
                        </button>
                        <button type="button" class="cartograph-btn cartograph-btn-undo" data-action="undoCandidate" title="Undo adjustment (Ctrl+Z)">
                            <i class="fas fa-undo"></i>
                        </button>
                    </div>
                </div>
                {{/if}}

                <!-- Waterbody List -->
                {{#if zones.length}}
                <div class="wc-entity-list">
                    {{#each zones as |z|}}
                    <div class="wc-entity-card {{#if z.isActive}}active{{/if}}" data-action="selectZone" data-region-id="{{z.id}}">
                        <div class="wc-card-archetype-icon" style="color: {{z.archetypeColor}};" title="{{z.archetypeLabel}}">
                            <i class="{{z.archetypeIcon}}"></i>
                        </div>
                        <div class="wc-card-details">
                            <span class="wc-zone-name" data-region-id="{{z.id}}" title="Rename">{{z.name}}</span>
                            <span class="wc-zone-meta">{{z.archetypeLabel}} &bull; {{z.verts}} pts</span>
                        </div>
                        <div class="wc-card-actions">
                            <button type="button" class="wc-card-btn wc-card-btn-edit {{#if (eq ../editingRegionId z.id)}}active{{/if}}" data-action="editZoneBoundary" data-region-id="{{z.id}}" title="{{#if (eq ../editingRegionId z.id)}}Cancel boundary editing{{else}}Refine boundary (Add/subtract water with sampler){{/if}}">
                                <i class="fas fa-pen-nib"></i>
                            </button>
                            <button type="button" class="wc-card-btn" data-action="focusZone" data-region-id="{{z.id}}" title="Focus on Canvas">
                                <i class="fas fa-crosshairs"></i>
                            </button>
                            <button type="button" class="wc-card-btn wc-card-btn-delete" data-action="deleteZone" data-region-id="{{z.id}}" title="Delete Waterbody">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    {{/each}}
                </div>
                {{else}}
                <p class="wc-empty-hint">No waterbodies on this scene.</p>
                {{/if}}
            </div>

            {{#if zones.length}}
            <!-- 2. Active Waterbody Archetype & Preset Selector (Unified Row) -->
            <div class="wc-archetype-bar ionrift-card">
                <div class="wc-archetype-preset-row">
                    <div class="wc-bar-col wc-archetype-col">
                        <label title="Fundamental waterbody fluid dynamics and environment classification">
                            <i class="fas fa-shapes"></i> Archetype
                        </label>
                        <select name="waterArchetype" class="ionrift-select">
                            {{#each archetypes as |arch key|}}
                            <option value="{{key}}" {{#if (eq ../activeArchetype key)}}selected{{/if}}>{{arch.label}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <div class="wc-bar-col wc-preset-col">
                        <label title="Atmospheric preset profiles curated for this archetype">
                            <i class="fas fa-bookmark"></i> Preset
                        </label>
                        <div class="wc-preset-select-wrap">
                            <select name="waterPreset" class="ionrift-select">
                                <optgroup label="{{activeArchetypeMeta.label}} Presets">
                                    {{#each currentArchetypePresets as |p k|}}
                                    <option value="{{k}}" {{#if (eq ../activePreset k)}}selected{{/if}}>{{p.label}}</option>
                                    {{/each}}
                                </optgroup>
                                {{#if customPresetsList.length}}
                                <optgroup label="Custom Presets">
                                    {{#each customPresetsList as |p|}}
                                    <option value="{{p.key}}" {{#if (eq ../activePreset p.key)}}selected{{/if}}>{{p.name}}</option>
                                    {{/each}}
                                </optgroup>
                                {{/if}}
                            </select>
                            <button type="button" class="wc-preset-btn wc-preset-save" data-action="promptSavePreset" title="Save current settings as a new custom preset">
                                <i class="fas fa-save"></i>
                            </button>
                            {{#if isCustomPresetSelected}}
                            <button type="button" class="wc-preset-btn wc-preset-delete" data-action="deleteWaterPreset" title="Delete this custom preset">
                                <i class="fas fa-trash"></i>
                            </button>
                            {{/if}}
                        </div>
                    </div>
                </div>

                <!-- Save Preset Inline Prompt -->
                <div class="wc-preset-save-prompt {{#unless showPresetPrompt}}hidden{{/unless}}">
                    <input type="text" name="newPresetName" class="wc-preset-name" placeholder="New preset name..." maxlength="30" />
                    <button type="button" class="cartograph-btn wc-preset-confirm" data-action="confirmSavePreset" title="Confirm Save">
                        <i class="fas fa-check"></i>
                    </button>
                    <button type="button" class="cartograph-btn wc-preset-cancel" data-action="cancelSavePreset" title="Cancel">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>

            <!-- 3. Curated Hero Sliders -->
            <div class="wc-hero-controls ionrift-card">
                <div class="wc-hero-header">
                    <h4>
                        <i class="{{activeArchetypeMeta.icon}}" style="color: {{activeArchetypeMeta.accentColor}};"></i>
                        {{activeArchetypeMeta.label}} Controls
                    </h4>
                    <span class="wc-hero-hint">{{activeArchetypeMeta.description}}</span>
                </div>

                <div class="wc-hero-sliders-body">
                    {{#if hasDirection}}
                    <!-- Directional Archetypes: Sliders on Left, Directional Arrow Dial on Right -->
                    <div class="wc-hero-split-wrap wc-river-hero-wrap">
                        <div class="wc-hero-sliders-col wc-river-sliders-col">
                            {{#each heroSliders as |slider|}}
                            {{#unless slider.isDirection}}
                            <div class="form-group hero-slider-group">
                                <label title="{{slider.tooltip}}">{{slider.label}}</label>
                                <div class="hero-input-wrap">
                                    <input type="range" name="hero_{{slider.id}}" min="{{slider.min}}" max="{{slider.max}}" value="{{slider.value}}" step="{{slider.step}}" data-hero-id="{{slider.id}}" />
                                    <span class="range-val">{{slider.displayValue}}</span>
                                </div>
                            </div>
                            {{/unless}}
                            {{/each}}
                        </div>
                        <div class="wc-hero-direction-col wc-river-direction-col">
                            {{#each heroSliders as |slider|}}
                            {{#if slider.isDirection}}
                            <div class="direction-widget" title="{{slider.tooltip}}">
                                <div class="direction-header">
                                    <label><i class="{{#if slider.icon}}{{slider.icon}}{{else}}fas fa-location-arrow{{/if}}"></i> {{slider.label}}</label>
                                    <span class="direction-angle-badge">{{slider.displayValue}}</span>
                                </div>
                                <div class="direction-dial">
                                    <div class="direction-arrow-pivot" style="transform: rotate({{slider.value}}deg);">
                                        <div class="direction-arrow"></div>
                                    </div>
                                    <div class="direction-center-dot"></div>
                                </div>
                            </div>
                            {{/if}}
                            {{/each}}
                        </div>
                    </div>
                    {{else}}
                    <!-- Standard 2-Column Grid for Non-Directional Archetypes (Pond, Puddle) -->
                    <div class="wc-hero-grid-2col">
                        {{#each heroSliders as |slider|}}
                        <div class="form-group hero-slider-group">
                            <label title="{{slider.tooltip}}">{{slider.label}}</label>
                            <div class="hero-input-wrap">
                                <input type="range" name="hero_{{slider.id}}" min="{{slider.min}}" max="{{slider.max}}" value="{{slider.value}}" step="{{slider.step}}" data-hero-id="{{slider.id}}" />
                                <span class="range-val">{{slider.displayValue}}</span>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                    {{/if}}
                </div>
            </div>

            {{!-- 4. Expandable Advanced FX Tuning Drawer (Disabled/Hidden for now)
            <details class="wc-advanced-drawer ionrift-card" {{#if drawerOpen}}open{{/if}}>
                <summary class="wc-drawer-summary">
                    <div class="summary-left">
                        <i class="fas fa-sliders-h"></i>
                        <span>Advanced Shader Levers</span>
                    </div>
                    <i class="fas fa-chevron-down drawer-chevron"></i>
                </summary>

                <div class="wc-drawer-content">
                    <!-- Subsection A: Wave & Mesh Dynamics -->
                    <div class="drawer-group-title"><i class="fas fa-wave-square"></i> Wave & Texture Dynamics</div>
                    <div class="drawer-grid-2col">
                        <div class="form-group-compact">
                            <label title="Base texture pattern scale">Scale</label>
                            <input type="range" name="scale" min="30" max="400" value="{{fx.scale}}" step="5" />
                            <span class="range-val">{{fx.scale}}</span>
                        </div>
                        <div class="form-group-compact">
                            <label title="Background refraction distortion strength">Distortion</label>
                            <input type="range" name="distortion" min="0.0" max="0.05" value="{{fx.distortion}}" step="0.001" />
                            <span class="range-val">{{numberFormat fx.distortion decimals=3}}</span>
                        </div>
                        <div class="form-group-compact">
                            <label title="Base animation speed">Speed</label>
                            <input type="range" name="speed" min="0.05" max="3.0" value="{{fx.speed}}" step="0.05" />
                            <span class="range-val">{{numberFormat fx.speed decimals=2}}</span>
                        </div>
                        <div class="form-group-compact">
                            <label title="Caustic brightness and prominence">Intensity</label>
                            <input type="range" name="intensity" min="0.0" max="2.0" value="{{fx.intensity}}" step="0.05" />
                            <span class="range-val">{{numberFormat fx.intensity decimals=2}}</span>
                        </div>
                    </div>

                    <!-- Subsection B: Shoreline & Swash Physics -->
                    <div class="drawer-group-title"><i class="fas fa-umbrella-beach"></i> Shoreline & Swash Physics</div>
                    <div class="drawer-grid-2col">
                        <div class="form-group-compact">
                            <label title="Width of the transparent edge blend in pixels">Edge Fade</label>
                            <input type="range" name="fadeWidth" min="0" max="200" value="{{fx.fadeWidth}}" step="5" />
                            <span class="range-val">{{fx.fadeWidth}}px</span>
                        </div>
                        <div class="form-group-compact">
                            <label title="Breaking shore wave foam intensity">Shore Waves</label>
                            <input type="range" name="shoreWaves" min="0.0" max="1.0" value="{{fx.shoreWaves}}" step="0.05" />
                            <span class="range-val">{{numberFormat fx.shoreWaves decimals=2}}</span>
                        </div>
                        <div class="form-group-compact">
                            <label title="Breaks continuous waves into traveling sets">Wave Breakup</label>
                            <input type="range" name="waveSegment" min="0.0" max="1.0" value="{{fx.waveSegment}}" step="0.05" />
                            <span class="range-val">{{numberFormat fx.waveSegment decimals=2}}</span>
                        </div>
                        <div class="form-group-compact">
                            <label title="Distance waves lap past shoreline onto dry land">Surge Reach</label>
                            <input type="range" name="swashSurge" min="0" max="60" value="{{fx.swashSurge}}" step="2" />
                            <span class="range-val">{{fx.swashSurge}}px</span>
                        </div>
                    </div>

                    <!-- Subsection C: Open Sea & Aeration -->
                    <div class="drawer-group-title"><i class="fas fa-water"></i> Open Sea & Foam Aeration</div>
                    <div class="drawer-grid-2col">
                        <div class="form-group-compact">
                            <label title="Multi-directional chop across open water">Open Sea Chop</label>
                            <input type="range" name="choppySeas" min="0.0" max="1.5" value="{{fx.choppySeas}}" step="0.05" />
                            <span class="range-val">{{numberFormat fx.choppySeas decimals=2}}</span>
                        </div>
                        <div class="form-group-compact">
                            <label title="Aerated foam crests on swells">Whitecaps</label>
                            <input type="range" name="whitecaps" min="0.0" max="1.5" value="{{fx.whitecaps}}" step="0.05" />
                            <span class="range-val">{{numberFormat fx.whitecaps decimals=2}}</span>
                        </div>
                        <div class="form-group-compact">
                            <label title="Sun highlights on wave crests">Sun Glint</label>
                            <input type="range" name="sunGlint" min="0.0" max="2.0" value="{{fx.sunGlint}}" step="0.05" />
                            <span class="range-val">{{numberFormat fx.sunGlint decimals=2}}</span>
                        </div>
                        <div class="form-group-compact">
                            <label title="Water flow direction in degrees">Flow Direction</label>
                            <input type="range" name="flowAngle" min="0" max="355" value="{{fx.flowAngle}}" step="5" />
                            <span class="range-val">{{fx.flowAngle}}&deg;</span>
                        </div>
                        <div class="form-group-compact checkbox-compact-group">
                            <label title="Foam wakes trailing behind traveling crests">
                                <input type="checkbox" name="spindriftWake" {{#if fx.spindriftWake}}checked{{/if}} /> Trailing Wake
                            </label>
                            <label title="Confines foam strictly to crest summits">
                                <input type="checkbox" name="crestBound" {{#if fx.crestBound}}checked{{/if}} /> Crest-Locked
                            </label>
                        </div>
                    </div>

                    <!-- Subsection D: Color & Tint -->
                    <div class="drawer-group-title"><i class="fas fa-palette"></i> Color & Opacity</div>
                    <div class="drawer-color-row">
                        <div class="color-picker-wrap">
                            <input type="color" name="colorOverride" value="{{fx.colorOverride}}" {{#if fx.autoColor}}disabled{{/if}} />
                            <label class="color-auto-label">
                                <input type="checkbox" name="autoColor" {{#if fx.autoColor}}checked{{/if}} /> Auto Sample Map
                            </label>
                        </div>
                        <div class="form-group-compact opacity-compact">
                            <label title="Water overlay tint opacity">Opacity</label>
                            <input type="range" name="opacity" min="0.05" max="0.5" value="{{fx.opacity}}" step="0.01" />
                            <span class="range-val">{{numberFormat fx.opacity decimals=2}}</span>
                        </div>
                    </div>
                </div>
            </details>
            --}}
            {{/if}}

            <!-- Tab 1 Footer -->
            <div class="wc-footer-actions">
                {{#if zones.length}}
                <div class="wc-footer-batch-row">
                    <label class="wc-batch-label" title="When checked, saves these settings to all waterbodies sharing this archetype on the scene">
                        <input type="checkbox" name="applyToAllSameArchetype" {{#if applyToAllSameArchetype}}checked{{/if}} />
                        <span>Apply to all <strong>{{activeArchetypeMeta.label}}</strong> bodies</span>
                    </label>
                </div>
                {{/if}}
                <div class="wc-footer-buttons">
                    {{#if zones.length}}
                    <button type="button" class="cartograph-btn cartograph-btn-save-fx" data-action="saveWaterFX">
                        <i class="fas fa-save"></i> Save to Waterbody
                    </button>
                    {{/if}}
                </div>
            </div>
        </section>

        <!-- ========================================================= -->
        <!-- TAB 2: WAKE & RIPPLES                                     -->
        <!-- ========================================================= -->
        <section class="tab {{#if (eq activeTab 'wake')}}active{{/if}}" data-tab="wake">
            
            <!-- Wake Presets -->
            <div class="wake-tg-presets">
                <label class="wake-tg-presets-label"><i class="fas fa-bookmark"></i> Preset</label>
                <select name="wakePresetSelect" class="wake-tg-preset-select">
                    <option value="" disabled {{#unless activeWakePreset}}selected{{/unless}}>
                        {{#if wakePresets.length}}Select preset...{{else}}No presets saved{{/if}}
                    </option>
                    {{#each wakePresets as |n|}}
                    <option value="{{n}}" {{#if (eq ../activeWakePreset n)}}selected{{/if}}>{{n}}</option>
                    {{/each}}
                </select>
                <button type="button" class="wake-tg-preset-save wc-preset-btn" data-action="promptSaveWakePreset" title="Save current ripple settings">
                    <i class="fas fa-save"></i>
                </button>
                {{#if activeWakePreset}}
                <button type="button" class="wake-tg-preset-del wc-preset-btn wc-preset-delete" data-action="deleteWakePreset" title="Delete selected ripple preset">
                    <i class="fas fa-trash"></i>
                </button>
                {{/if}}
            </div>

            <div class="wake-tg-save-prompt {{#unless showWakePresetPrompt}}hidden{{/unless}}">
                <input type="text" name="newWakePresetName" class="wake-tg-preset-name wc-preset-name" placeholder="Preset name..." />
                <button type="button" class="wake-tg-preset-confirm cartograph-btn wc-preset-confirm" data-action="confirmSaveWakePreset">
                    <i class="fas fa-check"></i>
                </button>
                <button type="button" class="wake-tg-preset-cancel cartograph-btn wc-preset-cancel" data-action="cancelSaveWakePreset">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="wake-tg-scroll">
                <p class="wake-tg-hint">Configure expanding ripple waves emitted as tokens navigate across water zones.</p>

                <!-- Visual Style -->
                <details class="wake-tg-details" open>
                    <summary>Visual Style</summary>
                    <div class="wake-tg-details-body">
                        <div class="form-group wake-tg-row">
                            <label>Display Mode</label>
                            <select name="wakeVisualMode">
                                <option value="shader" {{#if (eq wake.visualMode 'shader')}}selected{{/if}}>Refraction only</option>
                                <option value="sprites" {{#if (eq wake.visualMode 'sprites')}}selected{{/if}}>Crest rings only</option>
                                <option value="both" {{#if (eq wake.visualMode 'both')}}selected{{/if}}>Combined (Refraction + Rings)</option>
                            </select>
                        </div>
                    </div>
                </details>

                <!-- Wave Shape & Lifetime -->
                <details class="wake-tg-details" open>
                    <summary>Wave Shape & Lifetime</summary>
                    <div class="wake-tg-details-body">
                        <div class="form-group wake-tg-row">
                            <label title="Lifespan of motion ripples">Lifetime (s)</label>
                            <input type="range" name="wake_duration" min="0.35" max="4" step="0.05" value="{{wake.duration}}" />
                            <span class="wake-tg-val">{{numberFormat wake.duration decimals=2}}</span>
                        </div>
                        <div class="form-group wake-tg-row">
                            <label title="Initial ring radius relative to token size">Start radius (x token)</label>
                            <input type="range" name="wake_rippleStartMul" min="0.2" max="2.0" step="0.05" value="{{wake.rippleStartMul}}" />
                            <span class="wake-tg-val">{{numberFormat wake.rippleStartMul decimals=2}}</span>
                        </div>
                        <div class="form-group wake-tg-row">
                            <label title="Maximum ring expansion relative to token size">Max radius (x token)</label>
                            <input type="range" name="wake_rippleMaxMul" min="1.0" max="5.0" step="0.1" value="{{wake.rippleMaxMul}}" />
                            <span class="wake-tg-val">{{numberFormat wake.rippleMaxMul decimals=2}}</span>
                        </div>
                        <div class="form-group wake-tg-row">
                            <label title="Number of concentric rings per ripple">Ring count</label>
                            <input type="range" name="wake_ringCount" min="1" max="6" step="1" value="{{wake.ringCount}}" />
                            <span class="wake-tg-val">{{wake.ringCount}}</span>
                        </div>
                        <div class="form-group wake-tg-row">
                            <label title="Peak opacity of ripple crests">Strength</label>
                            <input type="range" name="wake_baseAlpha" min="0.1" max="1" step="0.05" value="{{wake.baseAlpha}}" />
                            <span class="wake-tg-val">{{numberFormat wake.baseAlpha decimals=2}}</span>
                        </div>
                        <div class="form-group wake-tg-row">
                            <label title="Variation in ring spacing and decay">Wave Dispersion</label>
                            <input type="range" name="wake_rippleVariance" min="0" max="2" step="0.05" value="{{wake.rippleVariance}}" />
                            <span class="wake-tg-val">{{numberFormat wake.rippleVariance decimals=2}}</span>
                        </div>
                    </div>
                </details>

                <!-- Motion Burst & Trail Ripples -->
                <details class="wake-tg-details">
                    <summary>Motion Burst & Trail Ripples</summary>
                    <div class="wake-tg-details-body">
                        <div class="form-group wake-tg-row">
                            <label title="Pixel lead ahead of moving tokens">Lead ahead (px)</label>
                            <input type="range" name="wake_rippleLeadPx" min="0" max="30" step="1" value="{{wake.rippleLeadPx}}" />
                            <span class="wake-tg-val">{{wake.rippleLeadPx}}</span>
                        </div>
                        <div class="form-group wake-tg-row">
                            <label title="Minimum movement distance to trigger ripple burst">Min move for burst (px)</label>
                            <input type="range" name="wake_minMoveDist" min="0" max="80" step="1" value="{{wake.minMoveDist}}" />
                            <span class="wake-tg-val">{{wake.minMoveDist}}</span>
                        </div>
                        <div class="form-group wake-tg-row">
                            <label title="Distance traveled between ripple emissions">Spawn cooldown (px)</label>
                            <input type="range" name="wake_spawnCooldownPx" min="5" max="100" step="1" value="{{wake.spawnCooldownPx}}" />
                            <span class="wake-tg-val">{{wake.spawnCooldownPx}}</span>
                        </div>
                        <div class="form-group wake-tg-row">
                            <label title="Maximum concurrent active ripples allowed">Total ripple budget</label>
                            <input type="range" name="wake_maxRipplesPool" min="10" max="120" step="1" value="{{wake.maxRipplesPool}}" />
                            <span class="wake-tg-val">{{wake.maxRipplesPool}}</span>
                        </div>
                        <div class="form-group wake-tg-row">
                            <label title="Duration movement wake persists">Trail lifetime (s)</label>
                            <input type="range" name="wake_refreshDuration" min="0.4" max="3" step="0.05" value="{{wake.refreshDuration}}" />
                            <span class="wake-tg-val">{{numberFormat wake.refreshDuration decimals=2}}</span>
                        </div>
                        <div class="form-group wake-tg-row">
                            <label title="Opacity of trailing movement wake">Trail strength</label>
                            <input type="range" name="wake_refreshBaseAlpha" min="0.1" max="1" step="0.05" value="{{wake.refreshBaseAlpha}}" />
                            <span class="wake-tg-val">{{numberFormat wake.refreshBaseAlpha decimals=2}}</span>
                        </div>
                    </div>
                </details>
            </div>

            <!-- Tab 2 Footer -->
            <div class="wc-footer-actions">
                <button type="button" class="cartograph-btn" data-action="resetWakeDefaults">
                    <i class="fas fa-undo"></i> Reset Default Physics
                </button>
            </div>
        </section>

    </div>
</div>
