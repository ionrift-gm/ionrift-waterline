<div class="waterline-studio-root">

    <!-- Primary Navigation Tabs -->
    <nav class="waterline-tabs" aria-label="{{localize 'IonriftWaterline.studio.tabsAria'}}">
        <button type="button" class="waterline-tab-btn {{#if (eq activeTab 'water')}}active{{/if}}" data-tab="water">
            <i class="fas fa-water"></i> <span>{{{localize 'IonriftWaterline.studio.tabWater'}}}</span>
        </button>
        <button type="button" class="waterline-tab-btn {{#if (eq activeTab 'wake')}}active{{/if}}" data-tab="wake">
            <i class="fas fa-wave-square"></i> <span>{{localize 'IonriftWaterline.studio.tabRipples'}}</span>
        </button>
    </nav>

    <div class="waterline-tab-body">

        <!-- ========================================================= -->
        <!-- TAB 1: WATER ZONES & FX                                   -->
        <!-- ========================================================= -->
        <section class="tab {{#if (eq activeTab 'water')}}active{{/if}}" data-tab="water">

            <!-- 1. Scene Waterbodies Entity Deck -->
            {{> "modules/ionrift-waterline/templates/parts/deck-zones.hbs"}}

            {{#if showFXControls}}
            <!-- 2. Active Waterbody Archetype & Preset Selector (Unified Row) -->
            <div class="wc-archetype-bar ionrift-card">
                <div class="wc-active-target-header">
                    <i class="{{activeArchetypeMeta.icon}}" style="color: {{activeArchetypeMeta.accentColor}};"></i>
                    <span class="wc-active-target-label">{{#if isConfiguringCandidate}}{{localize 'IonriftWaterline.studio.targetNew'}}{{else}}{{localize 'IonriftWaterline.studio.targetSelected'}}{{/if}}</span>
                    <strong class="wc-active-target-name">{{activeTargetName}}</strong>
                </div>
                <div class="wc-archetype-preset-row">
                    <div class="wc-bar-col wc-archetype-col">
                        <label title="{{localize 'IonriftWaterline.studio.archetypeLabelTitle'}}">
                            <i class="fas fa-shapes"></i> {{localize 'IonriftWaterline.studio.archetypeLabel'}}
                        </label>
                        <select name="waterArchetype" class="ionrift-select">
                            {{#each archetypes as |arch key|}}
                            <option value="{{key}}" {{#if (eq ../activeArchetype key)}}selected{{/if}}>{{arch.label}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <div class="wc-bar-col wc-preset-col">
                        <label title="{{localize 'IonriftWaterline.studio.presetLabelTitle'}}">
                            <i class="fas fa-bookmark"></i> {{localize 'IonriftWaterline.studio.presetLabel'}}
                        </label>
                        <div class="wc-preset-select-wrap">
                            <select name="waterPreset" class="ionrift-select">
                                <optgroup label="{{localize 'IonriftWaterline.studio.archetypePresetsGroup' label=activeArchetypeMeta.label}}">
                                    {{#each currentArchetypePresets as |p k|}}
                                    <option value="{{k}}" {{#if (eq ../activePreset k)}}selected{{/if}}>{{p.label}}</option>
                                    {{/each}}
                                </optgroup>
                                {{#if customPresetsList.length}}
                                <optgroup label="{{localize 'IonriftWaterline.studio.customPresetsGroup'}}">
                                    {{#each customPresetsList as |p|}}
                                    <option value="{{p.key}}" {{#if (eq ../activePreset p.key)}}selected{{/if}}>{{p.name}}</option>
                                    {{/each}}
                                </optgroup>
                                {{/if}}
                            </select>
                            <button type="button" class="wc-preset-btn wc-preset-save" data-action="promptSavePreset" title="{{localize 'IonriftWaterline.studio.savePresetTitle'}}">
                                <i class="fas fa-save"></i>
                            </button>
                            {{#if isCustomPresetSelected}}
                            <button type="button" class="wc-preset-btn wc-preset-delete" data-action="deleteWaterPreset" title="{{localize 'IonriftWaterline.studio.deletePresetTitle'}}">
                                <i class="fas fa-trash"></i>
                            </button>
                            {{/if}}
                        </div>
                    </div>
                </div>

                <!-- Save Preset Inline Prompt -->
                <div class="wc-preset-save-prompt {{#unless showPresetPrompt}}hidden{{/unless}}">
                    <input type="text" name="newPresetName" class="wc-preset-name" placeholder="{{localize 'IonriftWaterline.studio.presetNamePlaceholder'}}" maxlength="30" />
                    <button type="button" class="cartograph-btn wc-preset-confirm" data-action="confirmSavePreset" title="{{localize 'IonriftWaterline.studio.confirmSavePresetTitle'}}">
                        <i class="fas fa-check"></i>
                    </button>
                    <button type="button" class="cartograph-btn wc-preset-cancel" data-action="cancelSavePreset" title="{{localize 'IonriftWaterline.studio.cancelSavePresetTitle'}}">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>

            <!-- 3. Curated Hero Sliders -->
            {{> "modules/ionrift-waterline/templates/parts/hero-controls.hbs"}}

            <!-- 4. Water Color & Tint Card (Across All Archetypes) -->
            <div class="wc-color-card ionrift-card">
                <div class="wc-color-card-header">
                    <div class="wc-color-card-title">
                        <i class="fas fa-palette"></i>
                        <span>{{localize 'IonriftWaterline.studio.colorHeading'}}</span>
                    </div>
                    <label class="wc-color-auto-toggle" title="{{localize 'IonriftWaterline.studio.autoColorTitle'}}">
                        <input type="checkbox" name="autoColor" {{#if fx.autoColor}}checked{{/if}} />
                        <span>{{localize 'IonriftWaterline.studio.autoSampleMap'}}</span>
                    </label>
                </div>
                <div class="wc-color-controls-row">
                    <div class="wc-color-picker-wrap" title="{{localize 'IonriftWaterline.studio.colorPickerTitle'}}" style="background-color: {{fx.colorOverride}};">
                        <input type="color" name="colorOverride" value="{{fx.colorOverride}}" class="wc-color-swatch-input" />
                    </div>
                    {{#if hasEyeDropper}}
                    <button type="button" class="cartograph-btn-mini wc-eyedropper-btn" data-action="sampleScreenColor" title="{{localize 'IonriftWaterline.studio.sampleColorMapTitle'}}">
                        <i class="fas fa-eye-dropper"></i>
                        <span>{{localize 'IonriftWaterline.studio.sampleMapBtn'}}</span>
                    </button>
                    {{/if}}
                    <div class="wc-color-hex-field-wrap" title="{{localize 'IonriftWaterline.studio.hexFieldTitle'}}">
                        <span class="wc-color-hex-prefix">#</span>
                        <input type="text" name="colorOverrideHex" class="wc-color-hex-input ws-color-hex-input" value="{{colorOverrideHex}}" placeholder="0D2E4D" maxlength="6" spellcheck="false" />
                    </div>
                    <div class="wc-color-status-pill {{#if fx.autoColor}}status-auto{{else}}status-override{{/if}}">
                        {{#if fx.autoColor}}
                        <i class="fas fa-eye"></i> <span>{{localize 'IonriftWaterline.studio.autoTintPill'}}</span>
                        {{else}}
                        <i class="fas fa-palette"></i> <span>{{localize 'IonriftWaterline.studio.customTintPill'}}</span>
                        {{/if}}
                    </div>
                </div>
            </div>
            {{/if}}

            <!-- Tab 1 Footer -->
            {{#if hasActiveZone}}
            <div class="wc-footer-actions">
                <div class="wc-footer-batch-row ws-batch-sync-toggle">
                    <label class="wc-batch-label" title="{{localize 'IonriftWaterline.studio.batchApplyTitle'}}">
                        <input type="checkbox" name="applyToAllSameArchetype" class="ws-batch-archetype-checkbox" {{#if applyToAllSameArchetype}}checked{{/if}} />
                        <span>{{{localize 'IonriftWaterline.studio.batchApplyLabel' label=activeArchetypeMeta.label}}}</span>
                    </label>
                </div>
                <div class="wc-footer-buttons">
                    <button type="button" class="cartograph-btn cartograph-btn-save-fx" data-action="saveWaterFX">
                        <i class="fas fa-save"></i> {{localize 'IonriftWaterline.studio.saveToWaterbody'}}
                    </button>
                </div>
            </div>
            {{/if}}
        </section>

        <!-- ========================================================= -->
        <!-- TAB 2: WAKE & RIPPLES                                     -->
        <!-- ========================================================= -->
        <section class="tab {{#if (eq activeTab 'wake')}}active{{/if}}" data-tab="wake">
            {{> "modules/ionrift-waterline/templates/parts/tab-wakes.hbs"}}
        </section>

    </div>
</div>
