<!-- Wake Presets -->
<div class="wake-tg-presets">
    <label class="wake-tg-presets-label"><i class="fas fa-bookmark"></i> {{localize 'IonriftWaterline.wake.presetsLabel'}}</label>
    <select name="wakePresetSelect" class="wake-tg-preset-select">
        <option value="" disabled {{#unless activeWakePreset}}selected{{/unless}}>
            {{#if wakePresets.length}}{{localize 'IonriftWaterline.wake.selectPreset'}}{{else}}{{localize 'IonriftWaterline.wake.noPresetsSaved'}}{{/if}}
        </option>
        {{#each wakePresets as |n|}}
        <option value="{{n}}" {{#if (eq ../activeWakePreset n)}}selected{{/if}}>{{n}}</option>
        {{/each}}
    </select>
    <button type="button" class="wake-tg-preset-save wc-preset-btn" data-action="promptSaveWakePreset" title="{{localize 'IonriftWaterline.wake.savePresetTitle'}}">
        <i class="fas fa-save"></i>
    </button>
    {{#if activeWakePreset}}
    <button type="button" class="wake-tg-preset-del wc-preset-btn wc-preset-delete" data-action="deleteWakePreset" title="{{localize 'IonriftWaterline.wake.deletePresetTitle'}}">
        <i class="fas fa-trash"></i>
    </button>
    {{/if}}
</div>

<div class="wake-tg-save-prompt {{#unless showWakePresetPrompt}}hidden{{/unless}}">
    <input type="text" name="newWakePresetName" class="wake-tg-preset-name wc-preset-name" placeholder="{{localize 'IonriftWaterline.wake.presetNamePlaceholder'}}" />
    <button type="button" class="wake-tg-preset-confirm cartograph-btn wc-preset-confirm" data-action="confirmSaveWakePreset">
        <i class="fas fa-check"></i>
    </button>
    <button type="button" class="wake-tg-preset-cancel cartograph-btn wc-preset-cancel" data-action="cancelSaveWakePreset">
        <i class="fas fa-times"></i>
    </button>
</div>

<div class="wake-tg-scroll">
    <p class="wake-tg-hint">{{localize 'IonriftWaterline.wake.tabHint'}}</p>

    <!-- Visual Style -->
    <details class="wake-tg-details" open>
        <summary>{{localize 'IonriftWaterline.wake.groupVisualStyle'}}</summary>
        <div class="wake-tg-details-body">
            <div class="form-group wake-tg-row">
                <label>{{localize 'IonriftWaterline.wake.displayModeLabel'}}</label>
                <select name="wakeVisualMode">
                    <option value="shader" {{#if (eq wake.visualMode 'shader')}}selected{{/if}}>{{localize 'IonriftWaterline.wake.modeRefraction'}}</option>
                    <option value="sprites" {{#if (eq wake.visualMode 'sprites')}}selected{{/if}}>{{localize 'IonriftWaterline.wake.modeCrestRings'}}</option>
                    <option value="both" {{#if (eq wake.visualMode 'both')}}selected{{/if}}>{{localize 'IonriftWaterline.wake.modeCombined'}}</option>
                </select>
            </div>
        </div>
    </details>

    <!-- Wave Shape & Lifetime -->
    <details class="wake-tg-details" open>
        <summary>{{{localize 'IonriftWaterline.wake.groupShapeLifetime'}}}</summary>
        <div class="wake-tg-details-body">
            <div class="form-group wake-tg-row">
                <label title="{{localize 'IonriftWaterline.wake.durationTitle'}}">{{localize 'IonriftWaterline.wake.durationLabel'}}</label>
                <input type="range" name="wake_duration" min="0.35" max="4" step="0.05" value="{{wake.duration}}" />
                <span class="wake-tg-val">{{numberFormat wake.duration decimals=2}}</span>
            </div>
            <div class="form-group wake-tg-row">
                <label title="{{localize 'IonriftWaterline.wake.rippleStartMulTitle'}}">{{localize 'IonriftWaterline.wake.rippleStartMulLabel'}}</label>
                <input type="range" name="wake_rippleStartMul" min="0.2" max="2.0" step="0.05" value="{{wake.rippleStartMul}}" />
                <span class="wake-tg-val">{{numberFormat wake.rippleStartMul decimals=2}}</span>
            </div>
            <div class="form-group wake-tg-row">
                <label title="{{localize 'IonriftWaterline.wake.rippleMaxMulTitle'}}">{{localize 'IonriftWaterline.wake.rippleMaxMulLabel'}}</label>
                <input type="range" name="wake_rippleMaxMul" min="1.0" max="5.0" step="0.1" value="{{wake.rippleMaxMul}}" />
                <span class="wake-tg-val">{{numberFormat wake.rippleMaxMul decimals=2}}</span>
            </div>
            <div class="form-group wake-tg-row">
                <label title="{{localize 'IonriftWaterline.wake.ringCountTitle'}}">{{localize 'IonriftWaterline.wake.ringCountLabel'}}</label>
                <input type="range" name="wake_ringCount" min="1" max="6" step="1" value="{{wake.ringCount}}" />
                <span class="wake-tg-val">{{wake.ringCount}}</span>
            </div>
            <div class="form-group wake-tg-row">
                <label title="{{localize 'IonriftWaterline.wake.baseAlphaTitle'}}">{{localize 'IonriftWaterline.wake.baseAlphaLabel'}}</label>
                <input type="range" name="wake_baseAlpha" min="0.1" max="1" step="0.05" value="{{wake.baseAlpha}}" />
                <span class="wake-tg-val">{{numberFormat wake.baseAlpha decimals=2}}</span>
            </div>
            <div class="form-group wake-tg-row">
                <label title="{{localize 'IonriftWaterline.wake.rippleVarianceTitle'}}">{{localize 'IonriftWaterline.wake.rippleVarianceLabel'}}</label>
                <input type="range" name="wake_rippleVariance" min="0" max="2" step="0.05" value="{{wake.rippleVariance}}" />
                <span class="wake-tg-val">{{numberFormat wake.rippleVariance decimals=2}}</span>
            </div>
        </div>
    </details>

    <!-- Motion Burst & Trail Ripples -->
    <details class="wake-tg-details">
        <summary>{{{localize 'IonriftWaterline.wake.groupMotionRipples'}}}</summary>
        <div class="wake-tg-details-body">
            <div class="form-group wake-tg-row">
                <label title="{{localize 'IonriftWaterline.wake.rippleLeadPxTitle'}}">{{localize 'IonriftWaterline.wake.rippleLeadPxLabel'}}</label>
                <input type="range" name="wake_rippleLeadPx" min="0" max="30" step="1" value="{{wake.rippleLeadPx}}" />
                <span class="wake-tg-val">{{wake.rippleLeadPx}}</span>
            </div>
            <div class="form-group wake-tg-row">
                <label title="{{localize 'IonriftWaterline.wake.minMoveDistTitle'}}">{{localize 'IonriftWaterline.wake.minMoveDistLabel'}}</label>
                <input type="range" name="wake_minMoveDist" min="0" max="80" step="1" value="{{wake.minMoveDist}}" />
                <span class="wake-tg-val">{{wake.minMoveDist}}</span>
            </div>
            <div class="form-group wake-tg-row">
                <label title="{{localize 'IonriftWaterline.wake.spawnCooldownPxTitle'}}">{{localize 'IonriftWaterline.wake.spawnCooldownPxLabel'}}</label>
                <input type="range" name="wake_spawnCooldownPx" min="5" max="100" step="1" value="{{wake.spawnCooldownPx}}" />
                <span class="wake-tg-val">{{wake.spawnCooldownPx}}</span>
            </div>
            <div class="form-group wake-tg-row">
                <label title="{{localize 'IonriftWaterline.wake.maxRipplesPoolTitle'}}">{{localize 'IonriftWaterline.wake.maxRipplesPoolLabel'}}</label>
                <input type="range" name="wake_maxRipplesPool" min="10" max="120" step="1" value="{{wake.maxRipplesPool}}" />
                <span class="wake-tg-val">{{wake.maxRipplesPool}}</span>
            </div>
            <div class="form-group wake-tg-row">
                <label title="{{localize 'IonriftWaterline.wake.refreshDurationTitle'}}">{{localize 'IonriftWaterline.wake.refreshDurationLabel'}}</label>
                <input type="range" name="wake_refreshDuration" min="0.4" max="3" step="0.05" value="{{wake.refreshDuration}}" />
                <span class="wake-tg-val">{{numberFormat wake.refreshDuration decimals=2}}</span>
            </div>
            <div class="form-group wake-tg-row">
                <label title="{{localize 'IonriftWaterline.wake.refreshBaseAlphaTitle'}}">{{localize 'IonriftWaterline.wake.refreshBaseAlphaLabel'}}</label>
                <input type="range" name="wake_refreshBaseAlpha" min="0.1" max="1" step="0.05" value="{{wake.refreshBaseAlpha}}" />
                <span class="wake-tg-val">{{numberFormat wake.refreshBaseAlpha decimals=2}}</span>
            </div>
        </div>
    </details>
</div>

<!-- Tab 2 Footer -->
<div class="wc-footer-actions">
    <button type="button" class="cartograph-btn" data-action="resetWakeDefaults">
        <i class="fas fa-undo"></i> {{localize 'IonriftWaterline.wake.resetDefaultPhysics'}}
    </button>
</div>
