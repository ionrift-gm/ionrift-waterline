<div class="wc-entity-deck">
    <div class="wc-deck-header">
        <div class="wc-deck-title">
            <i class="fas fa-layer-group"></i>
            <span>{{localize 'IonriftWaterline.deck.heading'}}</span>
            <span class="wc-zone-count-badge">{{zones.length}}</span>
        </div>
        <div class="wc-deck-actions">
            <button type="button" class="cartograph-btn-mini {{#if regionPickActive}}pick-active{{/if}}" data-action="toggleRegionPick" title="{{#if regionPickActive}}{{localize 'IonriftWaterline.deck.stopRegionPickTitle'}}{{else}}{{localize 'IonriftWaterline.deck.startRegionPickTitle'}}{{/if}}">
                {{#if regionPickActive}}
                <i class="fas fa-stop-circle"></i> {{localize 'IonriftWaterline.deck.stopBtn'}}
                {{else}}
                <i class="fas fa-draw-polygon"></i> {{localize 'IonriftWaterline.deck.fromRegionBtn'}}
                {{/if}}
            </button>
            <button type="button" class="cartograph-btn-mini {{#if pickActive}}pick-active{{/if}}" data-action="togglePick" title="{{#if pickActive}}{{localize 'IonriftWaterline.deck.stopSamplingTitle'}}{{else}}{{localize 'IonriftWaterline.deck.startSamplingTitle'}}{{/if}}">
                {{#if pickActive}}
                <i class="fas fa-stop-circle"></i> {{localize 'IonriftWaterline.deck.stopBtn'}}
                {{else}}
                <i class="fas fa-crosshairs"></i> {{localize 'IonriftWaterline.deck.newWaterbodyBtn'}}
                {{/if}}
            </button>
        </div>
    </div>

    <!-- Region Pick Mode Controls -->
    {{#if regionPickActive}}
    <div class="wc-pick-controls ionrift-subcard">
        <div class="wc-refine-hint">
            <i class="fas fa-mouse-pointer"></i> {{#if unattachedRegions.length}}{{localize 'IonriftWaterline.deck.regionPickHintWithUnattached'}}{{else}}{{localize 'IonriftWaterline.deck.regionPickHint'}}{{/if}}
        </div>
        {{#if unattachedRegions.length}}
        <div class="wc-unattached-row">
            <select class="ionrift-select wc-unattached-select" name="unattachedRegionSelect">
                {{#each unattachedRegions as |ur|}}
                <option value="{{ur.id}}" {{#if ur.isSelected}}selected{{/if}}>{{ur.name}} ({{#if ur.estimation}}{{ur.estimation.archetypeLabel}} &bull; {{/if}}{{localize 'IonriftWaterline.deck.pointsCount' count=ur.verts}})</option>
                {{/each}}
            </select>
            <button type="button" class="cartograph-btn-mini" data-action="adoptSceneRegion" title="{{localize 'IonriftWaterline.deck.adoptRegionTitle'}}">
                <i class="fas fa-plus"></i> {{localize 'IonriftWaterline.deck.adoptRegionBtn'}}
            </button>
        </div>
        {{/if}}
    </div>
    {{/if}}

    <!-- Pick Mode Controls -->
    {{#if pickActive}}
    <div class="wc-pick-controls ionrift-subcard">
        <div class="form-group-compact">
            <label title="{{localize 'IonriftWaterline.deck.toleranceTitle'}}">{{localize 'IonriftWaterline.deck.toleranceLabel'}}</label>
            <input type="range" name="pickTolerance" min="1" max="120" value="{{pickTolerance}}" step="1" />
            <span class="range-val">{{pickTolerance}}</span>
        </div>
        <div class="form-group-compact">
            <label title="{{{localize 'IonriftWaterline.deck.smoothingTitle'}}}">{{localize 'IonriftWaterline.deck.smoothingLabel'}}</label>
            <input type="range" name="pickSmoothing" min="0.5" max="15" value="{{pickSmoothing}}" step="0.5" />
            <span class="range-val">{{pickSmoothing}}</span>
        </div>
        <div class="wc-refine-hint">
            <i class="fas fa-mouse-pointer"></i> {{{localize 'IonriftWaterline.deck.pickModeHint'}}}
        </div>
    </div>
    {{/if}}

    <!-- Live Candidate Card -->
    {{#if candidate}}
    <div class="wc-candidate ionrift-subcard {{#if editingRegionName}}editing{{/if}}">
        <div class="wc-candidate-header">
            <i class="fas {{#if editingRegionName}}fa-pen-nib{{else}}fa-magic{{/if}}"></i>
            {{#if editingRegionName}}
            <span>{{{localize 'IonriftWaterline.deck.refiningCandidate' name=editingRegionName count=candidate.vertexCount}}}</span>
            {{else}}
            <span>{{localize 'IonriftWaterline.deck.sampledCandidate' count=candidate.vertexCount}}</span>
            {{/if}}
            {{#if candidate.estimation}}
            <span class="wc-candidate-tag" title="{{candidate.estimation.explanation}}">
                <span class="wc-tag-prefix">{{localize 'IonriftWaterline.deck.detectedPrefix'}}</span>
                <i class="{{candidate.estimation.icon}}" style="color: {{candidate.estimation.accentColor}};"></i>
                {{candidate.estimation.archetypeLabel}}
            </span>
            {{/if}}
        </div>
        {{#if (gt candidate.vertexCount 60)}}
        <p class="wc-vert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            {{localize 'IonriftWaterline.deck.complexBoundaryWarning'}}
        </p>
        {{/if}}
        <div class="wc-candidate-toolbar">
            <span class="wc-toolbar-label"><i class="fas fa-sliders-h"></i> {{localize 'IonriftWaterline.deck.toolbarBoundary'}}</span>
            <div class="wc-toolbar-buttons">
                <button type="button" class="cartograph-btn wc-btn-tool" data-action="pullBackCandidate" title="{{localize 'IonriftWaterline.deck.pullBackTitle'}}">
                    <i class="fas fa-compress-alt"></i> {{localize 'IonriftWaterline.deck.pullBackBtn'}}
                </button>
                <button type="button" class="cartograph-btn wc-btn-tool" data-action="expandCandidate" title="{{localize 'IonriftWaterline.deck.expandTitle'}}">
                    <i class="fas fa-expand-alt"></i> {{localize 'IonriftWaterline.deck.expandBtn'}}
                </button>
                <button type="button" class="cartograph-btn wc-btn-tool" data-action="smoothCandidate" title="{{localize 'IonriftWaterline.deck.smoothTitle'}}">
                    <i class="fas fa-bezier-curve"></i> {{localize 'IonriftWaterline.deck.smoothBtn'}}
                </button>
            </div>
        </div>
        <div class="wc-candidate-actions">
            <button type="button" class="cartograph-btn cartograph-btn-accept" data-action="acceptCandidate">
                <i class="fas fa-check"></i> {{#if editingRegionName}}{{localize 'IonriftWaterline.deck.updateWaterbody'}}{{else}}{{localize 'IonriftWaterline.deck.acceptCandidate'}}{{/if}}
            </button>
            <button type="button" class="cartograph-btn cartograph-btn-discard" data-action="discardCandidate">
                <i class="fas fa-times"></i> {{#if editingRegionName}}{{localize 'IonriftWaterline.deck.cancelEditing'}}{{else}}{{localize 'IonriftWaterline.deck.discardCandidate'}}{{/if}}
            </button>
            <button type="button" class="cartograph-btn cartograph-btn-undo" data-action="undoCandidate" title="{{localize 'IonriftWaterline.deck.undoTitle'}}">
                <i class="fas fa-undo"></i>
            </button>
        </div>
    </div>
    {{/if}}

    <!-- Waterbody List -->
    {{#if zones.length}}
    <div class="wc-entity-list">
        {{#each zones as |z|}}
        <div class="wc-entity-card {{#if z.isActive}}active{{/if}}" data-action="selectZone" data-region-id="{{z.id}}">
            <div class="wc-card-archetype-icon" style="color: {{z.archetypeColor}};" title="{{z.archetypeLabel}}">
                <i class="{{z.archetypeIcon}}"></i>
            </div>
            <div class="wc-card-details">
                <span class="wc-zone-name" data-region-id="{{z.id}}" title="{{localize 'IonriftWaterline.deck.renameTitle'}}">{{z.name}}</span>
                <span class="wc-zone-meta">{{z.archetypeLabel}} &bull; {{localize 'IonriftWaterline.deck.pointsCount' count=z.verts}}</span>
            </div>
            <div class="wc-card-actions">
                <button type="button" class="wc-card-btn wc-card-btn-edit {{#if (eq ../editingRegionId z.id)}}active{{/if}}" data-action="editZoneBoundary" data-region-id="{{z.id}}" title="{{#if (eq ../editingRegionId z.id)}}{{localize 'IonriftWaterline.deck.cancelBoundaryEditing'}}{{else}}{{localize 'IonriftWaterline.deck.refineBoundary'}}{{/if}}">
                    <i class="fas fa-pen-nib"></i>
                </button>
                <button type="button" class="wc-card-btn" data-action="focusZone" data-region-id="{{z.id}}" title="{{localize 'IonriftWaterline.deck.focusCanvasTitle'}}">
                    <i class="fas fa-crosshairs"></i>
                </button>
                <button type="button" class="wc-card-btn wc-card-btn-delete" data-action="deleteZone" data-region-id="{{z.id}}" title="{{localize 'IonriftWaterline.deck.deleteWaterbodyTitle'}}">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <p class="wc-empty-hint">{{localize 'IonriftWaterline.deck.emptyHint'}}</p>
    {{/if}}

    <!-- Unattached Scene Regions (Ready to adopt as waterbodies) -->
    {{#if unattachedRegions.length}}
    {{#unless regionPickActive}}
    <div class="wc-unattached-bar ionrift-subcard">
        <div class="wc-unattached-header">
            <i class="fas fa-draw-polygon" style="color: #38bdf8;"></i>
            <span class="wc-unattached-label">{{localize 'IonriftWaterline.deck.newSceneRegion'}}</span>
        </div>
        <div class="wc-unattached-row">
            <select class="ionrift-select wc-unattached-select" name="unattachedRegionSelect">
                {{#each unattachedRegions as |ur|}}
                <option value="{{ur.id}}" {{#if ur.isSelected}}selected{{/if}}>{{ur.name}} ({{#if ur.estimation}}{{ur.estimation.archetypeLabel}} &bull; {{/if}}{{localize 'IonriftWaterline.deck.pointsCount' count=ur.verts}})</option>
                {{/each}}
            </select>
            <button type="button" class="cartograph-btn-mini" data-action="adoptSceneRegion" title="{{localize 'IonriftWaterline.deck.adoptRegionTitle'}}">
                <i class="fas fa-plus"></i> {{localize 'IonriftWaterline.deck.adoptRegionBtn'}}
            </button>
        </div>
    </div>
    {{/unless}}
    {{/if}}
</div>
