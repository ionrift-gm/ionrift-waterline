<div class="wc-entity-deck">
    <div class="wc-deck-header">
        <div class="wc-deck-title">
            <i class="fas fa-layer-group"></i>
            <span>Scene Waterbodies</span>
            <span class="wc-zone-count-badge">{{zones.length}}</span>
        </div>
        <button type="button" class="cartograph-btn-mini {{#if pickActive}}pick-active{{/if}}" data-action="togglePick" title="{{#if pickActive}}Stop sampling{{else}}Sample water color from map (Shift to add, Ctrl to subtract){{/if}}">
            {{#if pickActive}}
            <i class="fas fa-stop-circle"></i> Stop
            {{else}}
            <i class="fas fa-crosshairs"></i> New Waterbody
            {{/if}}
        </button>
    </div>

    <!-- Pick Mode Controls -->
    {{#if pickActive}}
    <div class="wc-pick-controls ionrift-subcard">
        <div class="form-group-compact">
            <label title="How close to match the color sample">Tolerance</label>
            <input type="range" name="pickTolerance" min="1" max="120" value="{{pickTolerance}}" step="1" />
            <span class="range-val">{{pickTolerance}}</span>
        </div>
        <div class="form-group-compact">
            <label title="Edge smoothing: lower = more detailed">Smoothing</label>
            <input type="range" name="pickSmoothing" min="0.5" max="15" value="{{pickSmoothing}}" step="0.5" />
            <span class="range-val">{{pickSmoothing}}</span>
        </div>
        <div class="wc-refine-hint">
            <i class="fas fa-mouse-pointer"></i> Click map to color sample. <kbd>Shift</kbd>+Click to add, <kbd>Ctrl</kbd>+Click to subtract.
        </div>
    </div>
    {{/if}}

    <!-- Live Candidate Card -->
    {{#if candidate}}
    <div class="wc-candidate ionrift-subcard {{#if editingRegionName}}editing{{/if}}">
        <div class="wc-candidate-header">
            <i class="fas {{#if editingRegionName}}fa-pen-nib{{else}}fa-magic{{/if}}"></i>
            {{#if editingRegionName}}
            <span>Refining: <strong>{{editingRegionName}}</strong> ({{candidate.vertexCount}} pts)</span>
            {{else}}
            <span>Sampled: {{candidate.vertexCount}} pts</span>
            {{/if}}
            {{#if candidate.estimation}}
            <span class="wc-candidate-tag" title="{{candidate.estimation.explanation}}">
                <i class="{{candidate.estimation.icon}}" style="color: {{candidate.estimation.accentColor}};"></i>
                {{candidate.estimation.archetypeLabel}}
            </span>
            {{/if}}
        </div>
        {{#if (gt candidate.vertexCount 60)}}
        <p class="wc-vert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            Complex boundary ({{candidate.vertexCount}} pts). Increase Smoothing to optimize.
        </p>
        {{/if}}
        <div class="wc-candidate-toolbar">
            <span class="wc-toolbar-label"><i class="fas fa-sliders-h"></i> Boundary:</span>
            <div class="wc-toolbar-buttons">
                <button type="button" class="cartograph-btn wc-btn-tool" data-action="pullBackCandidate" title="Erode 1 step">
                    <i class="fas fa-compress-alt"></i> Pull Back
                </button>
                <button type="button" class="cartograph-btn wc-btn-tool" data-action="expandCandidate" title="Expand 1 step">
                    <i class="fas fa-expand-alt"></i> Expand
                </button>
                <button type="button" class="cartograph-btn wc-btn-tool" data-action="smoothCandidate" title="Smooth jagged corners">
                    <i class="fas fa-bezier-curve"></i> Smooth
                </button>
            </div>
        </div>
        <div class="wc-refine-hint">
            <i class="fas fa-layer-group"></i> <kbd>Shift</kbd>+Click map to add regions, <kbd>Ctrl</kbd>+Click to subtract.
        </div>
        <div class="wc-candidate-actions">
            <button type="button" class="cartograph-btn cartograph-btn-accept" data-action="acceptCandidate">
                <i class="fas fa-check"></i> {{#if editingRegionName}}Update Waterbody{{else}}Accept{{/if}}
            </button>
            <button type="button" class="cartograph-btn cartograph-btn-discard" data-action="discardCandidate">
                <i class="fas fa-times"></i> {{#if editingRegionName}}Cancel{{else}}Discard{{/if}}
            </button>
            <button type="button" class="cartograph-btn cartograph-btn-undo" data-action="undoCandidate" title="Undo (Ctrl+Z)">
                <i class="fas fa-undo"></i>
            </button>
        </div>
    </div>
    {{/if}}

    <!-- Waterbody List -->
    {{#if zones.length}}
    <div class="wc-entity-list">
        {{#each zones as |z|}}
        <div class="wc-entity-card {{#if z.isActive}}active{{/if}}" data-action="selectZone" data-region-id="{{z.id}}">
            <div class="wc-card-archetype-icon" style="color: {{z.archetypeColor}};" title="{{z.archetypeLabel}}">
                <i class="{{z.archetypeIcon}}"></i>
            </div>
            <div class="wc-card-details">
                <span class="wc-zone-name" data-region-id="{{z.id}}" title="Rename">{{z.name}}</span>
                <span class="wc-zone-meta">{{z.archetypeLabel}} &bull; {{z.verts}} pts</span>
            </div>
            <div class="wc-card-actions">
                <button type="button" class="wc-card-btn wc-card-btn-edit {{#if (eq ../editingRegionId z.id)}}active{{/if}}" data-action="editZoneBoundary" data-region-id="{{z.id}}" title="{{#if (eq ../editingRegionId z.id)}}Cancel boundary editing{{else}}Refine boundary (Add/subtract water with sampler){{/if}}">
                    <i class="fas fa-pen-nib"></i>
                </button>
                <button type="button" class="wc-card-btn" data-action="focusZone" data-region-id="{{z.id}}" title="Focus on Canvas">
                    <i class="fas fa-crosshairs"></i>
                </button>
                <button type="button" class="wc-card-btn wc-card-btn-delete" data-action="deleteZone" data-region-id="{{z.id}}" title="Delete Waterbody">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <p class="wc-empty-hint">No waterbodies on this scene.</p>
    {{/if}}

    <!-- Unattached Scene Regions (Ready to adopt as waterbodies) -->
    {{#if unattachedRegions.length}}
    <div class="wc-unattached-bar ionrift-subcard">
        <div class="wc-unattached-header">
            <i class="fas fa-draw-polygon" style="color: #38bdf8;"></i>
            <span class="wc-unattached-label">New Scene Region:</span>
        </div>
        <div class="wc-unattached-row">
            <select class="ionrift-select wc-unattached-select" name="unattachedRegionSelect">
                {{#each unattachedRegions as |ur|}}
                <option value="{{ur.id}}">{{ur.name}} ({{#if ur.estimation}}{{ur.estimation.archetypeLabel}} &bull; {{/if}}{{ur.verts}} pts)</option>
                {{/each}}
            </select>
            <button type="button" class="cartograph-btn-mini" data-action="adoptSceneRegion" title="Convert selected region into a Waterline waterbody">
                <i class="fas fa-plus"></i> Add
            </button>
        </div>
    </div>
    {{/if}}
</div>
